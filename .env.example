# Never put real credentials in this file.
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_HMAC_SECRET=

# Base64-encoded random 32-byte key for application-layer AES-256-GCM token encryption.
# Generate a real value outside the repo (for example: openssl rand -base64 32) and store it only as a deployment secret.
RING_TOKEN_ENCRYPTION_KEY=

# Added automatically when an Upstash Redis database is linked to the Vercel project.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
